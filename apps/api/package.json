{
  "name": "@lacecms/app-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "pnpm run build && node dist/dev.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint src",
    "test": "pnpm run build && vitest run src/*.test.mjs"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@lacecms/platform-node": "workspace:*",
    "@lacecms/server": "workspace:*"
  },
  "devDependencies": {
    "@lacecms/application": "workspace:*",
    "@lacecms/config": "workspace:*",
    "@lacecms/domain": "workspace:*",
    "@types/node": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
