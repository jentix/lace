---
import type { BlockContext, PublicBlock } from "../lib/rendering.js";
import { readOptionalString, readRequiredString } from "../lib/rendering.js";

interface Props {
  readonly block: PublicBlock;
  readonly context: BlockContext;
  readonly mediaUrl: (mediaId: string) => string;
}

const { block, context, mediaUrl } = Astro.props;
const alt = readRequiredString(block, context, "alt");
const caption = readOptionalString(block, context, "caption");
const media = readRequiredString(block, context, "media");
---

<figure data-lace-block={block.type} data-lace-block-key={block.key}>
  <img alt={alt} data-lace-part="media" src={mediaUrl(media)} />
  {caption !== undefined && <figcaption data-lace-part="caption">{caption}</figcaption>}
</figure>
