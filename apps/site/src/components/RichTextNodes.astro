---
import type { SafeRichTextNode } from "../lib/rich-text.js";
import RichTextMarks from "./RichTextMarks.astro";
import RichTextNodes from "./RichTextNodes.astro";

interface Props {
  readonly nodes: readonly SafeRichTextNode[];
}

const { nodes } = Astro.props;
---

{
  nodes.map((node) => {
    if (node.type === "text") return <RichTextMarks marks={node.marks ?? []} text={node.text} />;
    if (node.type === "hardBreak") return <br />;
    if (node.type === "paragraph") return <p><RichTextNodes nodes={node.content ?? []} /></p>;
    if (node.type === "heading") {
      if (node.attrs.level === 1) return <h1><RichTextNodes nodes={node.content ?? []} /></h1>;
      if (node.attrs.level === 2) return <h2><RichTextNodes nodes={node.content ?? []} /></h2>;
      return <h3><RichTextNodes nodes={node.content ?? []} /></h3>;
    }
    if (node.type === "bulletList") return <ul><RichTextNodes nodes={node.content} /></ul>;
    if (node.type === "orderedList") return <ol><RichTextNodes nodes={node.content} /></ol>;
    if (node.type === "listItem") return <li><RichTextNodes nodes={node.content} /></li>;
    return <blockquote><RichTextNodes nodes={node.content} /></blockquote>;
  })
}
