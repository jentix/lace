---
import type { BlockContext, PublicBlock } from "../lib/rendering.js";
import { readOptionalDocument, readRequiredString, readUrl } from "../lib/rendering.js";
import RichText from "./RichText.astro";

interface Props {
  readonly block: PublicBlock;
  readonly context: BlockContext;
}

const { block, context } = Astro.props;
const actionLabel = readRequiredString(block, context, "actionLabel");
const actionUrl = readUrl(block, context, "actionUrl");
const body = readOptionalDocument(block, context, "body");
const heading = readRequiredString(block, context, "heading");
---

<aside class="cta" data-lace-block={block.type} data-lace-block-key={block.key}>
  <h2 data-lace-part="heading">{heading}</h2>
  {body !== undefined && <div data-lace-part="body"><RichText document={body} /></div>}
  <a data-lace-part="action" href={actionUrl}>{actionLabel}</a>
</aside>
