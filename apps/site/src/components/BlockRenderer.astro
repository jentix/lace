---
import type { SiteEntry } from "../lib/site-data.js";
import { assertRenderableBlock } from "../lib/rendering.js";
import CtaBlock from "./CtaBlock.astro";
import HeroBlock from "./HeroBlock.astro";
import ImageBlock from "./ImageBlock.astro";
import QuoteBlock from "./QuoteBlock.astro";
import RichTextBlock from "./RichTextBlock.astro";

interface Props {
  readonly entry: SiteEntry;
  readonly mediaUrl: (mediaId: string) => string;
}

const { entry, mediaUrl } = Astro.props;
---

{
  entry.blocks.map((block) => {
    const context = { entryId: entry.id, key: block.key, modelKey: entry.modelKey };
    assertRenderableBlock(block, context);
    if (block.type === "hero") return <HeroBlock block={block} context={context} mediaUrl={mediaUrl} />;
    if (block.type === "richText") return <RichTextBlock block={block} context={context} />;
    if (block.type === "image") return <ImageBlock block={block} context={context} mediaUrl={mediaUrl} />;
    if (block.type === "quote") return <QuoteBlock block={block} context={context} />;
    if (block.type === "cta") return <CtaBlock block={block} context={context} />;
    throw new TypeError(`Cannot render block ${block.key} for model ${entry.modelKey} entry ${entry.id}.`);
  })
}
