---
import BlockRenderer from "../../components/BlockRenderer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteData } from "../../lib/site-data.js";

export async function getStaticPaths() {
  const { posts } = await getSiteData();
  return posts.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const { mediaUrl } = await getSiteData();
---

<BaseLayout title={entry.title}>
  <BlockRenderer entry={entry} mediaUrl={mediaUrl} />
</BaseLayout>
