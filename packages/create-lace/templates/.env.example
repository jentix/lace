# Copy to .env and provide your own values. No usable credentials are generated.
LACE_PUBLIC_BASE_URL=http://127.0.0.1:3000/
LACE_DATABASE_PATH=./lace.sqlite
# Optional Cloudflare operator target settings:
LACE_D1_DATABASE_ID=
LACE_CLOUDFLARE_PERSIST_TO=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
LACE_WRANGLER_CONFIG=
LACE_API_IMAGE=
LACE_BUILDER_IMAGE=
LACE_AUTH_SECRET=
LACE_MINIO_ROOT_ACCESS_KEY=
LACE_MINIO_ROOT_SECRET=
LACE_BUILDER_SECRET=
LACE_BUILD_TOKEN=
