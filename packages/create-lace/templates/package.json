{
  "name": "{{PROJECT_NAME}}",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --dir site dev",
    "dev:api": "docker compose up -d minio minio-init migrate api",
    "dev:stop": "docker compose down",
    "prod:start": "docker compose up -d",
    "prod:stop": "docker compose down",
    "build": "pnpm --dir site build",
    "typecheck": "pnpm --dir site typecheck",
    "db:migrate": "node --env-file=.env node_modules/@lacecms/cli/dist/bin.js db migrate",
    "content:sync": "node --env-file=.env node_modules/@lacecms/cli/dist/bin.js content sync",
    "auth:bootstrap": "node --env-file=.env node_modules/@lacecms/cli/dist/bin.js auth bootstrap"
  },
  "dependencies": {
    "@lacecms/cli": "0.1.0-alpha.1",
    "@lacecms/config": "0.1.0-alpha.1",
    "@lacecms/content": "0.1.0-alpha.1"
  },
  "devDependencies": {
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=24.12.0 <25",
    "pnpm": ">=12 <13"
  },
  "packageManager": "pnpm@12.3.4"
}
