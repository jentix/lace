---
import BlockRenderer from "../../components/BlockRenderer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSiteData } from "../../lib/site-data.js";

export async function getStaticPaths() {
  const { posts } = await getSiteData();
  return posts.map((entry) => ({ params: { slug: entry.slug } }));
}

// Read the current post rather than cached route props so Astro dev shows
// publications on reload; a static build uses the same single export.
const { mediaUrl, posts } = await getSiteData();
const entry = posts.find((post) => post.slug === Astro.params.slug);
if (entry === undefined) return new Response(null, { status: 404 });
---

<BaseLayout entry={entry} title={entry.title}>
  <BlockRenderer entry={entry} mediaUrl={mediaUrl} />
</BaseLayout>
