---
import type { BlockContext, PublicBlock } from "../lib/rendering.js";
import { readOptionalString, readRequiredString } from "../lib/rendering.js";

interface Props {
  readonly block: PublicBlock;
  readonly context: BlockContext;
}

const { block, context } = Astro.props;
const attribution = readOptionalString(block, context, "attribution");
const quote = readRequiredString(block, context, "quote");
---

<blockquote data-lace-block={block.type} data-lace-block-key={block.key}>
  <p data-lace-part="text">{quote}</p>
  {attribution !== undefined && <footer data-lace-part="attribution">{attribution}</footer>}
</blockquote>
