---
import type { SafeRichTextMark } from "../lib/rich-text.js";
import RichTextMarks from "./RichTextMarks.astro";

interface Props {
  readonly index?: number;
  readonly marks: readonly SafeRichTextMark[];
  readonly text: string;
}

const { index = 0, marks, text } = Astro.props;
const mark = marks[index];
---

{
  mark === undefined ? (
    text
  ) : mark.type === "bold" ? (
    <strong><RichTextMarks index={index + 1} marks={marks} text={text} /></strong>
  ) : mark.type === "italic" ? (
    <em><RichTextMarks index={index + 1} marks={marks} text={text} /></em>
  ) : mark.type === "strike" ? (
    <s><RichTextMarks index={index + 1} marks={marks} text={text} /></s>
  ) : mark.type === "code" ? (
    <code><RichTextMarks index={index + 1} marks={marks} text={text} /></code>
  ) : (
    <a href={mark.attrs.href}><RichTextMarks index={index + 1} marks={marks} text={text} /></a>
  )
}
